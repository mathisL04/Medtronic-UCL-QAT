mlruns/

###############################################
# Model weights and deployment exports
###############################################
# Engines, ONNX and checkpoints are NOT committed -- their *.provenance.json
# sidecars are, and they carry the sha256 plus the full build configuration, so
# any artifact here is identifiable and rebuildable. A handful of files are
# deliberate exceptions, force-added with `git add -f`; see the README.

*.pt
*.pth
*.onnx
*.engine
*.trt
*.torchscript
*.tflite

###############################################
# TensorRT / CUDA temporary outputs
###############################################

*.plan
*.cache
*.bin
*.trtmodel

###############################################
# Generated results and figures
###############################################
# Blanket-ignored because runs produce them in bulk. Curated ones under
# reports/ and experiments/ are force-added; that is intentional, not a slip.

*.png
*.csv
notebooks/layer_comparison_common.csv

