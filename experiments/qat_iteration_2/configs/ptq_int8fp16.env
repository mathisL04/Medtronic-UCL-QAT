# INT8 + FP16 fallback PTQ baseline (max-quant deploy) — env knobs for the reused
# Phase-1 build script scripts/tensorrt/build_tensorrt_engine.py.
#
# Difference vs V4 (which was INT8 + FP32 fallback): INT8_ALLOW_FP16=1 sets the
# FP16 builder flag alongside INT8, so the layers TensorRT does NOT run in INT8
# fall back to FP16 instead of FP32.
#
# Usage (from repo root, in the TensorRT venv):
#   set -a; source experiments/qat_iteration_2/configs/ptq_int8fp16.env; set +a
#   DEVICE=<idle_gpu> python scripts/tensorrt/build_tensorrt_engine.py
# then relocate the produced engine + sidecar into ptq_baseline/.
PRECISION=int8
INT8_ALLOW_FP16=1
CALIBRATOR=entropy
CALIB_DIR=/home/zcemml1/medtronic_qat_data/calib_int8_train_yolo   # 500 frames, seed 42, disjoint from val
IMG_SIZE=640
WORKSPACE_GB=8
ALLOW_TF32=0
